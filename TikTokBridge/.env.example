NODE_ENV=production
HOST=127.0.0.1
PORT=3000
LIVE_PROVIDER=tiktok
TIKFINITY_WS_URL=ws://127.0.0.1:21213/

# Keep disabled unless you intentionally expose the bridge to a trusted LAN.
ALLOW_LAN=0

# Tai khoan TikTok tu ket noi khi bam start.bat (khong co dau @). De trong: nhap o Bang dieu khien.
TIKTOK_USERNAME=
# Khoa ky cua eulerstream (tuy chon, chi dung khi LIVE_PROVIDER=tiktok)
EULER_API_KEY=
# web  = ban web (public/bar.html), dan http://localtest.me:3000/bar.html vao TikTok LIVE Studio (mac dinh)
# unity = mo game Unity Build\TIKTOK_LIVE_BAR.exe nhu ban goc
GAME_MODE=web
